# Port published on the host and listened on inside the container.
APP_PORT=5373

# SQLite database inside the container. /data is the mounted volume (./data on the host).
DATABASE_URL=sqlite:////data/app.db

# IANA timezone used by the application. APP_TIMEZONE wins when both are set.
# TZ also sets the container clock.
APP_TIMEZONE=Europe/London
TZ=Europe/London

# development or production.
APP_ENV=production

# Optional HTTP Basic auth. Leave both unset to run open on localhost.
# Set both together. There is no registration and no user account store.
# APP_AUTH_USER=
# APP_AUTH_PASSWORD=
